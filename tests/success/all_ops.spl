const let zero = fn() -> i64 { 0 }
const let one = fn() -> i64 { 1 }

const let unary_op_const_int = fn() {
    if (-0) !=  0 { __builtin_trap() }
    if (~0) != -1 { __builtin_trap() }
    if (!0) !=  1 { __builtin_trap() }
}

const let unary_op_int = fn() {
    let z = zero()
    if (-z) !=  0 { __builtin_trap() }
    if (~z) != -1 { __builtin_trap() }
    if (!z) !=  1 { __builtin_trap() }
}

const let const_int_binary_op_const_int = fn() {
    if (0 *  0) != 0 { __builtin_trap() }
    if (0 /  1) != 0 { __builtin_trap() }
    if (0 %  1) != 0 { __builtin_trap() }
    if (0 +  0) != 0 { __builtin_trap() }
    if (0 -  0) != 0 { __builtin_trap() }
    if (0 << 0) != 0 { __builtin_trap() }
    if (0 >> 0) != 0 { __builtin_trap() }
    if (0 <  0) != 0 { __builtin_trap() }
    if (0 <= 0) != 1 { __builtin_trap() }
    if (0 >  0) != 0 { __builtin_trap() }
    if (0 >= 0) != 1 { __builtin_trap() }
    if (0 == 0) != 1 { __builtin_trap() }
    if (0 != 0) != 0 { __builtin_trap() }
    if (0 &  0) != 0 { __builtin_trap() }
    if (0 ^  0) != 0 { __builtin_trap() }
    if (0 |  0) != 0 { __builtin_trap() }
    if (0 && 0) != 0 { __builtin_trap() }
    if (0 || 0) != 0 { __builtin_trap() }
}

const let const_int_binary_op_int = fn() {
    let z = zero()
    let o = one()
    if (0 *  z) != 0 { __builtin_trap() }
    if (0 /  o) != 0 { __builtin_trap() }
    if (0 %  o) != 0 { __builtin_trap() }
