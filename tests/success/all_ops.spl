    if (z ^  0) != 0 { __builtin_trap() }
    if (z |  0) != 0 { __builtin_trap() }
    if (z && 0) != 0 { __builtin_trap() }
    if (z || 0) != 0 { __builtin_trap() }
}

const let int_binary_op_int = fn() {
    let z = zero()
    let o = one()
    if (z *  z) != 0 { __builtin_trap() }
    if (z /  o) != 0 { __builtin_trap() }
    if (z %  o) != 0 { __builtin_trap() }
    if (z +  z) != 0 { __builtin_trap() }
    if (z -  z) != 0 { __builtin_trap() }
    if (z << z) != 0 { __builtin_trap() }
    if (z >> z) != 0 { __builtin_trap() }
    if (z <  z) != 0 { __builtin_trap() }
    if (z <= z) != 1 { __builtin_trap() }
    if (z >  z) != 0 { __builtin_trap() }
    if (z >= z) != 1 { __builtin_trap() }
    if (z == z) != 1 { __builtin_trap() }
    if (z != z) != 0 { __builtin_trap() }
