    if (0 >> z) != 0 { __builtin_trap() }
    if (0 <  z) != 0 { __builtin_trap() }
    if (0 <= z) != 1 { __builtin_trap() }
    if (0 >  z) != 0 { __builtin_trap() }
    if (0 >= z) != 1 { __builtin_trap() }
    if (0 == z) != 1 { __builtin_trap() }
    if (0 != z) != 0 { __builtin_trap() }
    if (0 &  z) != 0 { __builtin_trap() }
    if (0 ^  z) != 0 { __builtin_trap() }
    if (0 |  z) != 0 { __builtin_trap() }
    if (0 && z) != 0 { __builtin_trap() }
    if (0 || z) != 0 { __builtin_trap() }
}

const let int_binary_op_const_int = fn() {
    let z = zero()
    if (z *  0) != 0 { __builtin_trap() }
    if (z /  1) != 0 { __builtin_trap() }
    if (z %  1) != 0 { __builtin_trap() }
    if (z +  0) != 0 { __builtin_trap() }
    if (z -  0) != 0 { __builtin_trap() }
