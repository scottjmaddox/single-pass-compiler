    if (z && z) != 0 { __builtin_trap() }
    if (z || z) != 0 { __builtin_trap() }
}

const let main = fn() {
    unary_op_const_int()
    unary_op_int()
    const_int_binary_op_const_int()
    const_int_binary_op_int()
